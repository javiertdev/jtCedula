{
    "name": "@javiert.dev/cedula",
    "version": "1.0.1",
    "description": "Una librería con algunas herramientas de validación para la cédula de identidad chilena",
    "author": {
        "name": "javiert.dev",
        "email": "npm@javiert.dev",
        "url": "https://javiert.dev"
    },
    "homepage": "https://github.com/javiertdev/jtCedula/wiki",
    "repository": "github:javiertdev/jtCedula",
    "license": "MIT",
    "keywords": [
        "jtcedula",
        "cedula",
        "identidad",
        "chile",
        "validacion",
        "carnet",
        "rut",
        "run",
        "rut-chileno",
        "rut-chile",
        "rut-validator",
        "edad-rut",
        "edad",
        "numero-documento",
        "serie",
        "typescript",
        "javascript",
        "library",
        "utils"
    ],
    "type": "module",
    "main": "./index.js",
    "exports": {
        ".": {
            "import": "./index.js",
            "require": "./index.js"
        }
    },
    "scripts": {
        "clear": "rm -r ./dist",
        "dev": "jtexec ./src/index.ts",
        "build": "tsc && node ./pkgBuild.cjs",
        "publish:local": "npm run build && cd dist && npm publish --registry http://localhost:4873",
        "publish:npm": "npm run build && cd dist && npm publish --access public",
        "min": "node esbuild.config.js"
    },
    "devDependencies": {
        "esbuild": "^0.27.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    }
}
